{
  "formulaVersion": "2.14",
  "lessons": [
    {
      "id": 1,
      "desc": "QA guard: price out of range",
      "source": "test-bad",
      "addedAt": 1784326089419
    },
    {
      "id": 2,
      "desc": "Harvest filter miss: multi-branch chains (Namq, Wooden) slipped through — signature research now double-checks branch count",
      "source": "overnight-signatures",
      "addedAt": 1784329758917
    },
    {
      "id": 3,
      "desc": "Signature rule: only sourced items with real prices go on demo pages; price-unknown items stay off (never invent)",
      "source": "overnight-signatures",
      "addedAt": 1784329758917
    },
    {
      "id": 4,
      "desc": "Dedup upgrade: accent/containment fuzzy matching (Salam Café vs Salam Cafe, Breehant vs Breehant Roastery)",
      "source": "wave3-merge",
      "addedAt": 1784337349225
    },
    {
      "id": 5,
      "desc": "Fleet guard: workflow args may arrive as JSON string — parse both forms and refuse to run with an empty target list (silent no-op caught twice)",
      "source": "top100-fleet-launch",
      "addedAt": 1784365987956
    },
    {
      "id": 6,
      "desc": "Session web-search budget is finite (200/session) — size research fleets within budget; agents must return found:false when starved, never invent",
      "source": "squadron3-budget",
      "addedAt": 1784366975567
    },
    {
      "at": 1784368803842,
      "lesson": "Delivery apps (HungerStation/Jahez) 403 direct fetches — harvest dishes/prices from search SNIPPETS + fetchable aggregators (ksamenus.com, cafesriyadh.com, menus-sa, tayarmedia, restaurant guru, sao.sa). Collect photo-lead URLs for Mac-side download instead of fetching images here.",
      "from": "swarm-10k"
    },
    {
      "at": 1784370680516,
      "lesson": "MacBook photo pipeline (verified): cafes’ own sites (Zid stores, WordPress, S3) + delivery/social og:image covers ARE fetchable on Mac; Instagram/TikTok are login/JS-walled (no yt-dlp = no video frames). Menus use 11 SHARED category keys at dist/assets/photos/<key>.jpg via <img onload->hasimg>; ONE real photo per key upgrades ALL luxe menus (no per-cafe slot in current template). Harvested 127 real photos from 52 cafes -> filled 10/11 keys; tea had no clean source so it stays illustrated (never fake it).",
      "from": "photo-mission-mac"
    },
    {
      "at": 1784371485175,
      "lesson": "loading=lazy on a display:none img never loads (no box, never intersects) so onload/hasimg never fires — photo slots must load eagerly; hidden state via display toggle is fine only without lazy.",
      "from": "photo-slot-bug"
    },
    {
      "at": 1784383851113,
      "lesson": "Detective panel verdict: data-elite is not visual-elite — emoji/SVG icons in signature cards read as placeholders and shared archetype items are recognizable across sibling menus. True purple needs per-cafe dish photos (Mac photo mission priority = the 16 purple cafes). Also caught: standard-tier medallion showed Latin initial in AR mode (fixed).",
      "from": "menu-detectors"
    },
    {
      "at": 1784389308379,
      "lesson": "Renderer v5 (from recovered Beyt+RUSTIC masters): real Google Fonts work on the LIVE site (visitor browser loads them). Per-cafe font pairs, light-paper vs dark-world moods, motifs, entrance flavors, greetings, real-handle footers — personality per cafe, deterministic, zero invented facts.",
      "from": "purple-factory-v5"
    },
    {
      "at": 1784392848971,
      "lesson": "Chrome breaks background-clip:text when transformed child spans animate inside — apply gradient class only after word entrance ends, then unwrap spans",
      "from": "masterpiece-50 hero bug"
    },
    {
      "id": 13,
      "desc": "Google Places Text Search returns wrong-business top hit for ~18% of cafes (generic names, wrong city). ALWAYS audit meta.json place_name vs expected + confirm Riyadh before trusting; purge mismatches (evidence rule).",
      "source": "photo-harvest-places",
      "addedAt": 1784465539825
    },
    {
      "id": 14,
      "desc": "RTL MIRROR LAW: built pages must use logical CSS only (margin-inline, inset-inline, text-align:start) — QA gate now fails any physical text-align:left/right or margin/padding-left/right in built html (qa.rtlMirror)",
      "source": "fusion-shortlist-rtl-audit",
      "addedAt": 1784471716709
    }
  ],
  "qa": {
    "priceMin": 5,
    "priceMax": 300,
    "minHtmlBytes": 4000,
    "requireArabic": true,
    "requireDisclaimer": true,
    "rtlMirror": true
  },
